SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<from supabase status: Secret>
# 통합 테스트용. supabase status의 "Publishable" 또는 "anon key".
# 신버전 CLI: sb_publishable_xxx... / 구버전: eyJ... (JWT)
SUPABASE_ANON_KEY=<from `supabase status` line "Publishable" or "anon key">
LOG_LEVEL=INFO
WORKER_RPC_PORT=8080
WORKER_RPC_SECRET=dev-secret-change-me
